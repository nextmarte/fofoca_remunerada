{
  "name": "escuta-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n app,worker -c blue,green \"next dev\" \"bun run src/workers/transcription.worker.ts\"",
    "dev:app": "next dev",
    "dev:worker": "bun run src/workers/transcription.worker.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "worker": "bun run src/workers/transcription.worker.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.65.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.8.2",
    "next": "16.0.5",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^6.9.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
