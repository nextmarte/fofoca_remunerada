// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== TABELAS NEXTAUTH ==========
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ========== TABELAS DA APLICAÇÃO ==========
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relacionamentos
  accounts       Account[]
  sessions       Session[]
  transcriptions Transcription[]
  usageQuota     UsageQuota?

  @@map("users")
}

model Transcription {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  title          String?
  text           String?             @db.Text
  language       String?
  duration       Int?                // duração do áudio em segundos
  wordCount      Int?                @map("word_count")
  status         TranscriptionStatus @default(PENDING)
  jobId          String?             @map("job_id") // ID do job no BullMQ para rastreamento
  errorMessage   String?             @map("error_message") @db.Text
  processingTime Int?                @map("processing_time") // em milissegundos
  cost           Decimal?            @db.Decimal(10, 6)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  completedAt    DateTime?           @map("completed_at")

  // Relacionamentos
  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  segments TranscriptionSegment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("transcriptions")
}

// Segmentos com timestamps
model TranscriptionSegment {
  id              String @id @default(cuid())
  transcriptionId String @map("transcription_id")
  startTime       Float  @map("start_time") // em segundos
  endTime         Float  @map("end_time")
  text            String @db.Text

  transcription Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  @@index([transcriptionId])
  @@map("transcription_segments")
}

// Controle de uso/quotas
model UsageQuota {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  monthlyMinutesLimit Int      @default(120) @map("monthly_minutes_limit") // 2 horas = 120 minutos
  usedMinutes         Float    @default(0) @map("used_minutes")
  totalTranscriptions Int      @default(0) @map("total_transcriptions")
  lastResetAt         DateTime @default(now()) @map("last_reset_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_quotas")
}

// ========== ENUMS ==========
enum TranscriptionStatus {
  PENDING    // Aguardando processamento
  PROCESSING // Em processamento
  COMPLETED  // Concluído com sucesso
  FAILED     // Falhou
  CANCELLED  // Cancelado pelo usuário
}
